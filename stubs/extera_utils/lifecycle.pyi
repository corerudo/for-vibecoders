import contextlib
from _typeshed import Incomplete
from collections.abc import Generator
from extera_utils.get_caller import ELYX_PLUGIN_NAMESPACE as ELYX_PLUGIN_NAMESPACE

class PluginScope:
    plugin_id: Incomplete
    stop_event: Incomplete
    def __init__(self, plugin_id) -> None: ...
    def close(self) -> None: ...
    def register_cleanup(self, cleanup): ...

class ManagedCallback:
    scope: Incomplete
    def __init__(self, fn, scope=None, once: bool = False, allow_stopped: bool = False, cleanup_task: bool = False) -> None: ...
    @property
    def cancelled(self): ...
    def set_cancel(self, cancel) -> None: ...
    def cancel(self) -> None: ...
    def __call__(self, *args, **kwargs): ...

def begin(plugin_id) -> None: ...
def stop(plugin_id) -> None: ...
def stop_all() -> None: ...
def capture_scope(fn=None): ...
def bind(fn, *, once: bool = False): ...
@contextlib.contextmanager
def plugin_context(plugin_id) -> Generator[None]: ...
@contextlib.contextmanager
def cleanup_context(scope) -> Generator[None]: ...
def bind_task(fn, *, once: bool = False, scope=None): ...
def bind_request(fn): ...
