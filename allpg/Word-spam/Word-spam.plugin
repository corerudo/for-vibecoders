import threading
import traceback

from java import jclass
from android_utils import copy_to_clipboard
from base_plugin import BasePlugin, HookResult, HookStrategy
from client_utils import send_text
from ui.bulletin import BulletinHelper

__id__ = "ws"
__name__ = "Спамер"
__description__ = "Отправляет слова по одному с заданной задержкой. Формат: .sp число слово1 слово2. Остановка: .stsp или .stsp all"
__version__ = "1.0.0"
__author__ = "@jaxbastard"
__icon__ = "DendziDzheksJaxbastard/11"
__min_version__ = "12.10.6"

MAX_DELAY_MS = 86400000


def _show_copyable_error(message, error):
    try:
        details = "".join(traceback.format_exception(type(error), error, error.__traceback__))
        BulletinHelper.show_with_button(
            message,
            jclass("org.telegram.messenger.R").raw.error,
            "Скопировать ошибку",
            on_click=lambda: copy_to_clipboard(details),
        )
    except Exception:
        try:
            BulletinHelper.show_error(message + ": " + str(error))
        except Exception:
            pass


def _notify(message):
    try:
        BulletinHelper.show_info(message)
    except Exception:
        pass


def _is_command(message, command):
    if not message.lower().startswith(command):
        return False
    return len(message) == len(command) or message[len(command)].isspace()


class _SendJob:
    def __init__(self, peer_id):
        self.peer_id = peer_id
        self.stop_event = threading.Event()


class WordSenderSPPlugin(BasePlugin):
    def on_plugin_load(self):
        self._jobs = []
        self._lock = threading.Lock()
        self.add_on_send_message_hook()

    def on_plugin_unload(self):
        self._stop_jobs()

    def _stop_jobs(self, peer_id=None):
        with self._lock:
            targets = [
                job
                for job in self._jobs
                if not job.stop_event.is_set() and (peer_id is None or job.peer_id == peer_id)
            ]
        for job in targets:
            job.stop_event.set()
        return len(targets)

    def on_send_message_hook(self, account, params):
        result = HookResult()
        message = getattr(params, "message", None)
        if not isinstance(message, str):
            return result

        message = message.strip()
        if _is_command(message, ".stsp"):
            return self._handle_stop(params, message, result)
        if not _is_command(message, ".sp"):
            return result

        parts = message.split()
        if len(parts) < 2:
            _show_copyable_error(
                "Нет слов для отправки",
                ValueError("Формат: .sp [задержка_мс] слово1 слово2"),
            )
            result.strategy = HookStrategy.CANCEL
            return result

        try:
            delay_ms = int(parts[1])
            words = parts[2:]
        except (TypeError, ValueError):
            delay_ms = 0
            words = parts[1:]

        if not words:
            _show_copyable_error(
                "Нет слов для отправки",
                ValueError("Формат: .sp [задержка_мс] слово1 слово2"),
            )
            result.strategy = HookStrategy.CANCEL
            return result

        if delay_ms < 0 or delay_ms > MAX_DELAY_MS:
            _show_copyable_error(
                "Задержка вне допустимого диапазона",
                ValueError("Задержка должна быть от 0 до 86400000 мс."),
            )
            result.strategy = HookStrategy.CANCEL
            return result

        peer_id = getattr(params, "peer", None)
        if peer_id is None:
            _show_copyable_error(
                "Не удалось определить текущий чат",
                RuntimeError("params.peer отсутствует"),
            )
            result.strategy = HookStrategy.CANCEL
            return result

        result.strategy = HookStrategy.CANCEL
        job = _SendJob(peer_id)
        with self._lock:
            self._jobs.append(job)
        worker = threading.Thread(
            target=self._send_words,
            args=(job, words, delay_ms),
            daemon=True,
            name="word-sender",
        )
        try:
            worker.start()
        except Exception as error:
            with self._lock:
                if job in self._jobs:
                    self._jobs.remove(job)
            _show_copyable_error("Не удалось запустить отправку", error)
        return result

    def _handle_stop(self, params, message, result):
        result.strategy = HookStrategy.CANCEL
        parts = message.split()
        stop_all = False
        if len(parts) > 1:
            if len(parts) == 2 and parts[1].lower() == "all":
                stop_all = True
            else:
                _show_copyable_error(
                    "Неверный формат остановки",
                    ValueError("Формат: .stsp или .stsp all"),
                )
                return result

        peer_id = getattr(params, "peer", None)
        if not stop_all and peer_id is None:
            _show_copyable_error(
                "Не удалось определить текущий чат",
                RuntimeError("params.peer отсутствует"),
            )
            return result

        stopped = self._stop_jobs(None if stop_all else peer_id)
        if stopped:
            _notify("Остановлено отправок: " + str(stopped))
        else:
            _notify("Нет активной отправки")
        return result

    def _send_words(self, job, words, delay_ms):
        delay_seconds = delay_ms / 1000.0
        last_index = len(words) - 1
        try:
            for index, word in enumerate(words):
                if job.stop_event.is_set():
                    return
                try:
                    send_text(job.peer_id, word)
                except Exception as error:
                    _show_copyable_error(
                        "Не удалось отправить слово " + str(index + 1),
                        error,
                    )
                    return
                if index < last_index and delay_seconds:
                    if job.stop_event.wait(delay_seconds):
                        return
        finally:
            with self._lock:
                if job in self._jobs:
                    self._jobs.remove(job)
