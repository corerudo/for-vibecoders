# EMBEDDED_NATIVE_END

_MAX_ROWS = 3000
_LOCK = threading.RLock()
_RECORDS = []
_STOP = threading.Event()
_READER = None
_READER_THREAD = None
_STATUS = "Нативный модуль не загружен"
_LOG_RE = re.compile(r"^(?P<date>\d{2}-\d{2})\s+(?P<clock>\d{2}:\d{2}:\d{2}(?:\.\d+)?)\s+(?P<pid>\d+)\s+(?P<tid>\d+)\s+(?P<level>[VDIWEAF])\s+(?P<tag>[^:]+):\s?(?P<message>.*)$")


def _add_line(line):
    line = str(line).rstrip("\r\n")
    if not line:
        return
    now = time.time()
    match = _LOG_RE.match(line)
    if match:
        data = match.groupdict()
        tag = data["tag"].strip()
        message = data["message"]
        stamp = data["date"] + " " + data["clock"][:8].replace(":", "-")
        pid = data["pid"]
        tid = data["tid"]
        level = data["level"]
    else:
        tag = "logcat"
        message = line
        stamp = time.strftime("%d-%m %H-%M-%S", time.localtime(now))
        pid = "?"
        tid = "?"
        level = None
    record = {"created": now, "id": tag, "name": tag, "tag": tag, "message": message, "full": line, "stamp": stamp, "pid": pid, "tid": tid, "level": level}
    with _LOCK:
        if _RECORDS and _RECORDS[-1]["full"] == line and now - _RECORDS[-1]["created"] < 1.0:
            return
        _RECORDS.append(record)
        if len(_RECORDS) > _MAX_ROWS:
            del _RECORDS[:-_MAX_ROWS]


def _reader_loop():
    global _STATUS
    buffer = ctypes.create_string_buffer(65536)
    while not _STOP.is_set():
        try:
            result = _READER.lv_read_line(buffer, len(buffer), 500)
            if result > 0:
                _add_line(buffer.value.decode("utf-8", "replace"))
            elif result < 0:
                _STATUS = "Нативный читатель остановился"
                break
        except Exception as exc:
            _STATUS = "Ошибка чтения: " + str(exc)
            log("lvie: ошибка чтения logcat: " + str(exc))
            break
    _STATUS = _STATUS if _STATUS != "Чтение logcat запущено" else "Чтение остановлено"


def _extract_native():
    import base64
    import zlib

    data = zlib.decompress(base64.b64decode(_SO_ARM64))
    base = None

    try:
        ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        try:
            base = str(ctx.getCodeCacheDir().getAbsolutePath())
        except Exception:
            base = str(ctx.getFilesDir().getAbsolutePath())
    except Exception:
        pass

    if not base:
        base = os.path.dirname(os.path.abspath(__file__))

    folder = os.path.join(base, "logcat_viewer_native")
    try:
        from java.io import File
        directory = File(folder)
        if not directory.exists():
            directory.mkdirs()
        folder = str(directory.getAbsolutePath())
    except Exception:
        os.makedirs(folder, exist_ok=True)

    path = os.path.join(folder, "liblogcat_reader.so")
    try:
        if os.path.getsize(path) == len(data):
            return path
    except OSError:
        pass

    with open(path, "wb") as output:
        output.write(data)
    return path


def _start_reader():
    global _READER, _READER_THREAD, _STATUS

    if _READER_THREAD is not None and _READER_THREAD.is_alive():
        return

    try:
        path = _extract_native()
        _READER = ctypes.CDLL(path)

        _READER.lv_start.restype = ctypes.c_int
        _READER.lv_read_line.argtypes = [
            ctypes.POINTER(ctypes.c_char),
            ctypes.c_int,
            ctypes.c_int,
        ]
        _READER.lv_read_line.restype = ctypes.c_int
        _READER.lv_stop.restype = None

        if _READER.lv_start() != 0:
            _READER = None
            _STATUS = "Не удалось запустить logcat. Доступ может быть ограничен Android."
            log("lvie: " + _STATUS)
            return

        _STOP.clear()
        _STATUS = "Чтение logcat запущено"
        _READER_THREAD = threading.Thread(
            target=_reader_loop,
            name="LogcatViewerNative",
            daemon=True,
        )
        _READER_THREAD.start()
    except Exception as exc:
        _READER = None
        _STATUS = "Ошибка загрузки нативного модуля: " + str(exc)
        log("lvie: " + _STATUS)

def _stop_reader():
    global _READER_THREAD, _READER
    _STOP.set()
    if _READER is not None:
        try:
            _READER.lv_stop()
        except Exception:
            pass
    _READER_THREAD = None
    _READER = None


def _all_records():
    with _LOCK:
        return list(reversed(_RECORDS))


class Plugin(BasePlugin):
    def on_plugin_load(self):
        log("lvie: загрузка плагина")
        _start_reader()
        log("lvie: запуск читателя logcat завершён; статус: " + _STATUS)

    def on_plugin_unload(self):
        log("lvie: выгрузка плагина")
        _stop_reader()

    def _refresh_logs(self, _view=None):
        log("lvie: обновление списка logcat")
        token = not bool(self.get_setting("_refresh_token", False))
        self.set_setting("_refresh_token", token, reload_settings=True)

    def _viewer(self):
        query = str(self.get_setting("search", "") or "").strip().lower()
        rows = [
            Header(text="Журнал logcat"),
            Input(key="search", text="Поиск по тегу или тексту", default=str(self.get_setting("search", "") or ""), icon="msg_search_solar", on_change=self._on_search),
            Text(text="Обновить список", icon="msg_clear_recent_solar", accent=True, on_click=self._refresh_logs),
        ]
        records = _all_records()
        if query:
            records = [r for r in records if query in r["tag"].lower() or query in r["message"].lower() or query in r["full"].lower()]
        if not records:
            rows.extend([Divider(), Text(text="Записей пока нет. Проверь наличие нативного модуля и доступ Android к logcat.", icon="msg_info_solar")])
            return rows
        rows.append(Divider(text="Записей: %d" % len(records)))
        for record in records:
            meta = "%s · %s:%s · %s" % (record["stamp"], record["pid"], record["tid"], record["tag"])
            if record.get("level"):
                meta += " · " + record["level"]
            rows.append(Text(text=record["message"] or record["tag"], subtext=meta, icon="msg_list_solar", on_click=lambda _view, item=record: self._show_record(item)))
        return rows

    def _on_search(self, value):
        query = "" if value is None else str(value)
        log("lvie: поиск logcat, запрос: " + query)
        self.set_setting("search", query, reload_settings=True)

    def _show_record(self, record):
        fragment = get_last_fragment()
        context = fragment.getParentActivity() if fragment is not None else None
        if context is None:
            return
        root = LinearLayout(context)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(8), AndroidUtilities.dp(16), AndroidUtilities.dp(12))
        heading = TextView(context)
        heading.setText("%s · %s" % (record["tag"], record["stamp"]))
        heading.setTextSize(16)
        heading.setTypeface(Typeface.DEFAULT, Typeface.BOLD)
        heading.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        root.addView(heading, LinearLayout.LayoutParams(-1, -2))
        scroll = ScrollView(context)
        body = TextView(context)
        body.setText(record["full"])
        body.setTextSize(13)
        body.setTypeface(Typeface.MONOSPACE)
        body.setTextIsSelectable(True)
        body.setGravity(Gravity.LEFT | Gravity.TOP)
        body.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        body.setPadding(0, AndroidUtilities.dp(12), 0, AndroidUtilities.dp(20))
        scroll.addView(body, ScrollView.LayoutParams(-1, -2))
        root.addView(scroll, LinearLayout.LayoutParams(-1, AndroidUtilities.dp(420)))
        builder = BottomSheet.Builder(context)
        builder.setTitle("Запись журнала", True)
        builder.setCustomView(root, Gravity.LEFT | Gravity.TOP)
        builder.setApplyTopPadding(False)
        builder.setApplyBottomPadding(True)
        builder.show()

    def create_settings(self):
        return self._viewer()


def create_plugin():
    return Plugin()
