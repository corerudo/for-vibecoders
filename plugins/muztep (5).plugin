__id__ = "muztep"
__name__ = "MuzTep downloader"
__description__ = "поиск и отправка треков с muztep.net\nкоманда: .shm автор - название"
__icon__ = "ZHynhs/1"
__version__ = "1.1.0"
__author__ = "@jaxbastard"
__min_version__ = "12.5.1"
__requirements__ = ["mutagen"]

import os
import re
from urllib.parse import urlparse

import requests
from bs4 import BeautifulSoup
import mutagen

from android_utils import copy_to_clipboard
from base_plugin import BasePlugin, HookResult, HookStrategy, MethodReplacement
from client_utils import run_on_queue, PLUGINS_QUEUE, send_audio, send_text
from file_utils import get_cache_dir
from hook_utils import find_class
from ui.bulletin import BulletinHelper
from org.telegram.messenger import R as R_tg

BASE_URL = "https://muztep.net"
HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (Linux; Android 13) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/124.0 Mobile Safari/537.36"
    ),
    "Accept-Language": "ru-RU,ru;q=0.9,en-US;q=0.8,en;q=0.7",
    "Referer": "https://muztep.net/",
}


class BypassInternalUriCheck(MethodReplacement):
    def replace_hooked_method(self, param):
        return False


class MuzTepPlugin(BasePlugin):

    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self._uri_hook = None

    def on_plugin_unload(self):
        self._unhook_uri()

    def _hook_uri(self):
        try:
            AndroidUtils = find_class("org.telegram.messenger.AndroidUtilities")
            Uri = find_class("android.net.Uri")
            method = AndroidUtils.getDeclaredMethod("isInternalUri", Uri)
            method.setAccessible(True)
            self._uri_hook = self.hook_method(method, BypassInternalUriCheck())
        except Exception:
            pass

    def _unhook_uri(self):
        try:
            if self._uri_hook:
                self.unhook_method(self._uri_hook)
                self._uri_hook = None
        except Exception:
            pass

    def on_send_message_hook(self, account, params):
        result = HookResult()

        if not hasattr(params, "message") or not isinstance(params.message, str):
            return result

        text = params.message.strip()

        if not text.lower().startswith(".shm "):
            return result

        raw = text[5:].strip()

        if not raw or " - " not in raw:
            BulletinHelper.show_error("неверный формат, используй: .shm автор - название")
            result.strategy = HookStrategy.CANCEL
            return result

        parts = raw.split(" - ", 1)
        artist_q = parts[0].strip()
        title_q = parts[1].strip()

        peer_id = params.peer if hasattr(params, "peer") else None

        run_on_queue(
            lambda: self._search_and_send(artist_q, title_q, peer_id),
            PLUGINS_QUEUE,
        )

        result.strategy = HookStrategy.CANCEL
        return result

    def _search_and_send(self, artist_q, title_q, peer_id):
        tmp_path = None
        try:
            BulletinHelper.show_info("ищу: " + artist_q + " — " + title_q)

            track = self._search_track(artist_q + " " + title_q)
            if not track:
                BulletinHelper.show_error("нет такого, еблан: " + artist_q + " — " + title_q)
                return

            meta = self._get_track_meta(track["track_url"])
            real_title = meta["title"] if meta["title"] else title_q
            real_artist = meta["artist"] if meta["artist"] else artist_q
            thumb_url = meta["thumb_url"]

            BulletinHelper.show_info("выгружаю: " + real_artist + " — " + real_title)

            cdn_url = self._get_cdn_url(track, real_artist, real_title)

            if not cdn_url:
                if peer_id:
                    send_text(
                        peer_id,
                        "<b>" + real_title + "</b> — " + real_artist + "\n"
                        + "<a href=\"" + track["track_url"] + "\">слушать на MuzTep</a>",
                        parse_mode="HTML",
                    )
                BulletinHelper.show_info("ошибка бля, на ссылку просто")
                return

            tmp_path = self._download(cdn_url, real_artist, real_title)

            thumb_bytes = None
            if thumb_url:
                try:
                    r = requests.get(thumb_url, headers=HEADERS, timeout=15)
                    r.raise_for_status()
                    thumb_bytes = r.content
                except Exception:
                    pass

            if peer_id:
                self._hook_uri()
                try:
                    self._send_track(
                        peer_id,
                        tmp_path,
                        real_artist + " — " + real_title + "\n---------\n" + track["track_url"],
                        real_artist,
                        real_title,
                        thumb_bytes,
                    )
                    BulletinHelper.show_info("найс: " + real_artist + " — " + real_title)
                finally:
                    self._unhook_uri()
            else:
                BulletinHelper.show_error("хуйня")

        except Exception as e:
            self._unhook_uri()
            if tmp_path and os.path.exists(tmp_path):
                try:
                    os.remove(tmp_path)
                except Exception:
                    pass
            err = str(e)
            BulletinHelper.show_with_button(
                "залупа: " + err,
                R_tg.raw.error,
                "Копировать",
                lambda: copy_to_clipboard(err),
                duration=BulletinHelper.DURATION_PROLONG,
            )

    def _search_track(self, query):
        url = BASE_URL + "/search/" + requests.utils.quote(query)
        resp = requests.get(url, headers=HEADERS, timeout=15)
        resp.raise_for_status()

        soup = BeautifulSoup(resp.text, "lxml")

        link = soup.find("a", href=re.compile(r"^/track/"))
        if not link:
            return None

        track_url = BASE_URL + link["href"]

        track_id_match = re.search(r"/track/[^/]+/(\d+)", track_url)
        if not track_id_match:
            return None
        track_id = track_id_match.group(1)

        return {"track_url": track_url, "track_id": track_id}

    def _get_track_meta(self, track_url):
        resp = requests.get(track_url, headers=HEADERS, timeout=15)
        resp.raise_for_status()

        soup = BeautifulSoup(resp.text, "lxml")
        actions = soup.find(class_="track-actions")

        title = None
        artist = None
        thumb_url = None

        if actions:
            title = actions.get("data-title")
            artist = actions.get("data-artist")
            thumb_url = actions.get("data-thumb")

        return {"title": title, "artist": artist, "thumb_url": thumb_url}

    def _send_track(self, peer_id, path, caption, artist, title, cover_bytes):
        try:
            from client_utils import _prepare_document, send_message
            from org.telegram.tgnet import TLRPC
            from org.telegram.messenger import ImageLoader
            from android.graphics import BitmapFactory
        except Exception:
            send_audio(peer_id, path, caption=caption)
            return

        document = _prepare_document(path, "audio/mpeg")
        if document is None:
            send_audio(peer_id, path, caption=caption)
            return

        attr = TLRPC.TL_documentAttributeAudio()
        attr.duration = self._duration(path)
        attr.title = title or ""
        attr.performer = artist or ""
        attr.flags = attr.flags | 1 | 2
        document.attributes.add(attr)

        if cover_bytes:
            try:
                bmp = BitmapFactory.decodeByteArray(cover_bytes, 0, len(cover_bytes))
                if bmp is not None:
                    thumb = ImageLoader.scaleAndSaveImage(bmp, 320, 320, 80, False)
                    if thumb is not None:
                        document.thumbs.add(thumb)
                    bmp.recycle()
            except Exception:
                pass

        send_message({"peer": peer_id, "document": document, "path": path, "caption": caption})

    def _duration(self, path):
        try:
            m = mutagen.File(path)
            if m is not None and m.info is not None:
                return float(m.info.length)
        except Exception:
            pass
        return 0.0

    def _get_cdn_url(self, track, artist, title):
        api_url = (
            BASE_URL + "/api/download/" + track["track_id"]
            + "?artist=" + requests.utils.quote(artist)
            + "&title=" + requests.utils.quote(title)
        )

        headers = dict(HEADERS)
        headers["Referer"] = track["track_url"]

        resp = requests.get(api_url, headers=headers, timeout=15)
        resp.raise_for_status()

        data = resp.json()
        return data.get("url")

    def _download(self, url, artist, title):
        cache_dir = get_cache_dir()

        with requests.get(url, headers=HEADERS, stream=True, timeout=120) as r:
            r.raise_for_status()
            ext = self._audio_ext(r.headers.get("Content-Type", ""), url)
            tmp_path = os.path.join(cache_dir, self._safe_name(artist, title) + ext)
            with open(tmp_path, "wb") as f:
                for chunk in r.iter_content(chunk_size=65536):
                    if chunk:
                        f.write(chunk)

        return tmp_path

    def _safe_name(self, artist, title):
        name = (artist + " - " + title).strip(" -")
        name = re.sub(r'[\\/:*?"<>|\x00-\x1f]', "_", name)[:120].strip()
        return name or "track"

    def _audio_ext(self, content_type, url):
        ct = content_type.split(";")[0].strip().lower()
        if ct in ("audio/mp4", "audio/x-m4a", "audio/aac"):
            return ".m4a"
        if ct in ("audio/mpeg", "audio/mp3"):
            return ".mp3"
        if urlparse(url).path.lower().endswith(".m4a"):
            return ".m4a"
        return ".mp3"